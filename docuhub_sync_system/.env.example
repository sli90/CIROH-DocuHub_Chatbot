# Required for summaries and embeddings
OPENAI_API_KEY=
SUMMARY_MODEL=gpt-5.2
EMBEDDING_MODEL=text-embedding-3-large

# Required when the dashboard pipeline updates PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=ciroh
POSTGRES_SCHEMA=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional. Public GitHub API access works without a token but is rate-limited.
GITHUB_TOKEN=

# Optional dashboard controls. With no operator token, pipeline execution is
# accepted only from the same machine (loopback requests).
DASHBOARD_OPERATOR_TOKEN=
DASHBOARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional pricing overrides in USD per 1 million tokens.
# OPENAI_SUMMARY_INPUT_USD_PER_1M=
# OPENAI_SUMMARY_CACHED_INPUT_USD_PER_1M=
# OPENAI_SUMMARY_OUTPUT_USD_PER_1M=
# OPENAI_EMBEDDING_INPUT_USD_PER_1M=
